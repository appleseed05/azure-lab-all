# ---------------------------------------------------------------
# Variables that needs to be configured
# those variables are duplicated, but commented to second time
# to match the organization of the file
# they are grouped here for quick and easy settings
# up to you to ignore this section and configure it in relevant section
# ---------------------------------------------------------------

prefix = "<prefixe-object>" # please use ONLY lower case, number and dash (-) as it is used in many object name, including F5 XC that accept only those characters

azure_sub_id        = "<subscription_ID>"
azure_tenant_id     = "<tenant_ID>"
azure_client_id     = "<client_ID>"
azure_client_secret = "<client_secret>"

azure_adminpassword  = "<your-admin-password>"
allowed_pips = ["1.2.3.4", "5.6.7.8"]
f5xc_api_p12_file = "<p12-file-name>" # the file must be located in the same folder as the Terraform files
f5xc_tenant_name = "<tenant-name>"
f5xc_namespace_name = "<namespace-name>"
f5xc_api_url = "https://<tenant-name>.console.ves.volterra.io/api"



# ---------------------------------------------------------------
# General
# ---------------------------------------------------------------
#prefix = "mylab"

# ---------------------------------------------------------------
# Azure subscription / service principal
# ---------------------------------------------------------------
# azure_sub_id        = "<subscription_ID>"
# azure_tenant_id     = "<tenant_ID>"
# azure_client_id     = "<client_ID>"
# azure_client_secret = "<client_secret>"

# ---------------------------------------------------------------
# Azure region and tags
# ---------------------------------------------------------------
azure_region    = "France Central"
azure_tag_owner = "John Doe"
azure_tag_env   = "My lab"

# ---------------------------------------------------------------
# Azure network CIDR
# ---------------------------------------------------------------

# Subnet within VNet 10.1.0.0/16
azure_cidr_vnet    = "10.1.0.0/16"
azure_cidr_sub_ext = "10.1.10.0/24"
azure_cidr_sub_int = "10.1.20.0/24"
azure_cidr_sub_adm = "10.1.1.0/24"
azure_cidr_sub_dmz = "10.1.90.0/24"


# ---------------------------------------------------------------
# Azure Resource Credentials
# ---------------------------------------------------------------
azure_admin_username = "lab"
azure_ssh_username   = "lab"
#azure_adminpassword  = "<your-admin-password>", it is recommanded to define it as environment variable

# allowed_pips = ["1.2.3.4", "5.6.7.8"]

# ---------------------------------------------------------------
# Azure Internal Load Balancer
# ---------------------------------------------------------------
azure_lbce_ip = "10.1.10.250"


# ---------------------------------------------------------------
# Azure VM & Network
# ---------------------------------------------------------------

azure_vm_ce01 = "vm-ce01"
azure_vm_ce02 = "vm-ce02"

azure_nic_ext_ip_addr = "10.1.10.5"

azure_nic_int_ip_addr = "10.1.20.5"

azure_nic_jmp_ip_addr = "10.1.1.5"

azure_nic_rtr_ext_ip_addr = "10.1.10.254"
azure_nic_rtr_dmz_ip_addr = "10.1.90.254"

azure_nic_xc_ce01_slo_ip_addr = "10.1.10.215"
azure_nic_xc_ce01_sli_ip_addr = "10.1.20.215"

azure_nic_xc_ce02_slo_ip_addr = "10.1.10.216"
azure_nic_xc_ce02_sli_ip_addr = "10.1.20.216"


# ---------------------------------------------------------------
# Azure VM size
# ---------------------------------------------------------------
azure_vm_size_srv   = "Standard_B2s"    # 2cpu - 4GB ram
azure_vm_size_jmp   = "Standard_D2s_v3" # 2cpu - 8GB ram (2 thread per core)
azure_vm_size_linux = "Standard_B2s"    # 2cpu - 4GB ram
azure_vm_size_rtr   = "Standard_D8s_v3" # 2cpu - 8GB ram (2 thread per core)
azure_vm_size_xc_ce = "Standard_D8_v4"  # 8cpu - 32GB ram

# ---------------------------------------------------------------
# Azure marketplace images
# ---------------------------------------------------------------
# SKU name "vyos-1-3" semms to be historical and Sentrium never renamed it.
# Offer and SKU include recent and incremented version.
# Please DON'T change the offer and SKU, you will still deploy versions 1.5.x.
#   az vm image list -l francecentral -p sentriumsl \
#     -f vyos-1-2-lts-on-azure -s vyos-1-3 --all -o table
# Current Terraform configuration works for version 1.4 and 1.5, but not on 1.3.

image_publisher_vyos = "sentriumsl"
image_offer_vyos     = "vyos-1-2-lts-on-azure"
image_sku_vyos       = "vyos-1-3"
image_version_vyos   = "1.5.1"

image_publisher_xcce = "f5-networks"
image_offer_xcce = "f5xc_customer_edge"
image_sku_xcce = "f5xccebyol"
image_version_xcce  = "9.2025.17"

image_publisher_ubuntu = "Canonical"
image_offer_ubuntu = "ubuntu-24_04-lts"
image_sku_ubuntu = "server"
image_version_ubuntu  = "latest"

# ---------------------------------------------------------------
# Router BGP & NAT
# ---------------------------------------------------------------
# maximum_paths_ebgp must be greater or equal to number of CE for ECMP
# to work with /32 VIP announced by several CE.

router_bgp_asn = 65001
router_bgp_maximum_paths_ebgp = 4

# ---------------------------------------------------------------
# Internal DNS (External VM)
# ---------------------------------------------------------------
dns_internal_zone = "f5demo.lan"

# ---------------------------------------------------------------
# Tinyproxy (External VM)
# ---------------------------------------------------------------
tinyproxy_port = 8888

# ---------------------------------------------------------------
# XC
# ---------------------------------------------------------------
# f5xc_api_p12_file = "<p12-file-path>"
# f5xc_api_url = "https://<tenant-name>.console.ves.volterra.io/api"
# f5xc_namespace_name = "<namespace-name>"

f5xc_bgp_asn           = "65100"
f5xc_vip_cidr          = "192.168.200.0/24"

f5xc_lb_nginx_fqdn        = ["mylab.mydomain.com", "mylab.internal.local"]
f5xc_lb_nginx_vip         = "192.168.200.5"
